# ==============================================================================
# RAG Knowledge Agent — Environment Configuration Template
# Copy to .env and fill in strong, unique secrets before starting the stack.
# Never commit .env to version control.
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_DB=rag_agent
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# --- Qdrant ---
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY

# --- Laravel web-app ---
APP_ENV=production
APP_DEBUG=false
# Generate with: php artisan key:generate --show
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_ARTISAN_KEY_GENERATE

# --- Internal Service Auth (Laravel <-> rag-core / ingest-worker) ---
RAG_INTERNAL_SECRET=CHANGE_ME_INTERNAL_SHARED_SECRET
RAG_CALLBACK_SECRET=CHANGE_ME_CALLBACK_SHARED_SECRET
INGEST_MAX_WORKERS=2
MONTHLY_SPEND_CAP_USD=200

# --- Ollama (Embeddings Only) ---
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=1
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- Generation (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_THINKING_BUDGET=0
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TIMEOUT_SECONDS=20

# --- Retrieval & Chunking ---
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RERANKER_ENABLED=false
SIMILARITY_THRESHOLD=0.35

# --- Reverse Proxy (Caddy) ---
# Default: internal TLS on LAN/VPN.
# For public ACME domain: set CADDY_SITE_ADDRESS=rag.yourdomain.com and CADDY_TLS=ops@yourdomain.com
# For Cloudflare Tunnel / upstream TLS termination: set CADDYFILE_PATH=./proxy/Caddyfile.tunnel and CADDY_SITE_ADDRESS=:80
CADDYFILE_PATH=./proxy/Caddyfile
CADDY_SITE_ADDRESS=https://localhost
CADDY_TLS=internal
